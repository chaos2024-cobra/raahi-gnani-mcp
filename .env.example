# --- Verified (Gnani Vachana STT/TTS) ---
GNANI_API_KEY=your-key
# GNANI_BASE_URL=https://api.vachana.ai

# --- Call platform (confirm with Gnani; paths below are ASSUMED) ---
GNANI_CALL_BASE_URL=https://api.inya.ai
GNANI_CALL_TRIGGER_PATH=/v1/calls/trigger
GNANI_CALL_STATS_PATH=/v1/conversations/{conversation_id}/statistics
GNANI_CALL_DTMF_PATH=/v1/calls/{conversation_id}/dtmf
GNANI_CALL_AUTH_HEADER=X-API-Key-ID
# GNANI_CALL_EXTRA_HEADERS={"X-Organization-ID":"...","X-API-User-ID":"..."}

# --- Guardrails ---
# Only these numbers can ever be called (comma-separated, E.164)
GNANI_ALLOWED_NUMBERS=+919800000000,+918012345678
# {"+918012345678":{"main_menu":{"1":"Accounts","2":"Statements","0":"Operator"}}}
GNANI_IVR_MENUS_FILE=./ivr_menus.json

# --- Capability 6: your own backend ---
CASE_STATUS_URL=https://api.yourapp.com/cases/{case_id}/checklist
CASE_STATUS_TOKEN=
CASE_STATUS_TIMEOUT_SECONDS=3
