# Raahi Gnani MCP - environment template.
# Copy to .env and fill in real values. Never commit .env.
# All values below are placeholders, not credentials.

# --- Gnani authentication (docs.gnani.ai) ---
# Gnani Speech APIs (Prisma STT / Timbre TTS) use header: X-API-Key-ID
# Gnani Platform API (trigger call / conversation stats) uses header: x-api-key
# The same key value may be used for both, but the header names differ per surface.
GNANI_API_KEY=your-gnani-api-key-placeholder

# --- Gnani Speech endpoints (officially documented, defaults applied in code) ---
# POST https://api.vachana.ai/stt/v3            (Gnani Prisma v2.5 STT REST)
GNANI_STT_URL=https://api.vachana.ai/stt/v3
# POST https://api.vachana.ai/api/v1/tts/inference (Gnani Timbre TTS REST)
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_CONTAINER=wav
GNANI_SPEECH_AUTH_HEADER=X-API-Key-ID

# --- Gnani Platform endpoints (officially documented, defaults applied in code) ---
# POST https://api.inya.ai/platform/v1/agents/{bot_id}/trigger_call?environment=...
GNANI_TRIGGER_CALL_URL=https://api.inya.ai/platform/v1/agents/{bot_id}/trigger_call
# GET https://api.inya.ai/platform/v1/conversations/{conversation_id}/stats
GNANI_CALL_OUTCOME_URL=https://api.inya.ai/platform/v1/conversations/{conversation_id}/stats
GNANI_PLATFORM_AUTH_HEADER=x-api-key
GNANI_BOT_ID=your-gnani-agent-bot-id
GNANI_CALL_ENVIRONMENT=development

# --- Gnani DTMF (NOT publicly documented as an endpoint) ---
# navigate_ivr fails with NOT_CONFIGURED until this is set to a Gnani-provided URL.
# Do not invent a URL; obtain the real one from Gnani.
GNANI_DTMF_URL=

# --- Gnani Custom Integrations / case status (Capability 6, PARTIAL in KEN.pdf) ---
# When empty, pull_case_status_into_call reads the built-in local demo case store.
# When set, it is called instead. {case_id} / {applicant_id} placeholders supported.
GNANI_CASE_STATUS_URL=
GNANI_CASE_STATUS_TOKEN=
GNANI_CASE_STATUS_TIMEOUT_SECONDS=3

# --- Guardrails ---
# Optional local allowlist of numbers this server may ever dial (comma separated).
# Empty = rely on Gnani's own number whitelist (provider still returns 400/403).
GNANI_ALLOWED_NUMBERS=

# --- Timeouts, retries, limits ---
GNANI_HTTP_TIMEOUT_SECONDS=10
GNANI_MAX_RETRIES=2
GNANI_RETRY_BACKOFF_SECONDS=0.5
GNANI_MAX_AUDIO_BYTES=10485760
GNANI_MAX_TTS_TEXT_CHARS=5000
GNANI_OUTCOME_POLL_MAX_ATTEMPTS=3
GNANI_OUTCOME_POLL_INTERVAL_SECONDS=1.0

# --- MCP transport security ---
# DNS-rebinding protection stays on; the allowlist defaults to loopback plus
# the deployed Render host (raahi-gnani-mcp-1.onrender.com) in src/config.py.
# Add extra hosts/origins below (comma separated); do not disable protection.
MCP_ENABLE_DNS_REBINDING_PROTECTION=true
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# --- Logging ---
LOG_LEVEL=INFO
